#version 460
// A game frame's scene image (display-encoded like the presented frames, at their size): its HUD-free capture
// (mode 0: linear, clamped and encoded the way the game's last pass writes the framebuffer) or, without one, the
// presented frame itself (mode 1). The depth passes match and blend these; the HUD is put back from the presented
// frames at the end (zn_interp_compose).
#extension GL_GOOGLE_include_directive : require
#include "zn_interp_common.glsl"
layout(binding = 0) uniform sampler2D src;
layout(binding = 6, rgba8) uniform writeonly image2D dst;

void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (outside(xy)) return;
    const vec2 uv = (vec2(xy) + 0.5) / p.dst_size;
    vec3 c;
    if (p.mode == 0) {
        // the capture is the game's picture alone: it goes where the frame shows it, the bars stay black
        const vec2 at = (uv - p.content.xy) / p.content.zw;
        c = any(lessThan(at, vec2(0.0))) || any(greaterThan(at, vec2(1.0)))
                ? vec3(0.0)
                : encode_srgb(min(texture(src, at).rgb, vec3(1.0)));
    } else {
        c = texture(src, uv).rgb;
    }
    imageStore(dst, xy, vec4(c, 1.0));
}
