#version 460
// Colour frame (display-encoded) -> luma at 1/r of its size (r = 2 or 4): each output texel averages its r x r
// block through 4 bilinear taps
#extension GL_GOOGLE_include_directive : require
#include "zn_interp_common.glsl"
layout(binding = 0) uniform sampler2D src;
layout(binding = 3, r32f) uniform writeonly image2D dst;

void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (outside(xy)) return;
    const vec2 uv = (vec2(xy) + 0.5) / p.dst_size;
    const vec2 r = vec2(textureSize(src, 0)) / p.dst_size;
    const vec2 o = (r * 0.5 - 1.0) / vec2(textureSize(src, 0));  // 4x4 block: taps 1 texel off the centre
    const vec3 c = texture(src, uv + vec2(-o.x, -o.y)).rgb + texture(src, uv + vec2(o.x, -o.y)).rgb +
                   texture(src, uv + vec2(-o.x, o.y)).rgb + texture(src, uv + vec2(o.x, o.y)).rgb;
    imageStore(dst, xy, vec4(dot(c * 0.25, vec3(0.299, 0.587, 0.114))));
}
